# SIARC - ambiente local/sandbox
N8N_ENCRYPTION_KEY=troque_esta_chave_em_producao_32_chars
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque_esta_senha_em_producao

# Chave exigida no header X-API-Key em toda chamada à API do SIARC
# (exceto /health). Gere uma nova antes de qualquer deploy fora de localhost:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SIARC_API_KEY=troque_esta_chave_em_producao
